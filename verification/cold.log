OrderedPartitions.original_threshold_two_consecutive {n : ℕ} (hn : 2 ≤ n) :
  OrderedPartitions.RootTracking.OrderedPair (n / 2) (OrderedPartitions.row n 2) (OrderedPartitions.row (n + 1) 2)
OrderedPartitions.TwoPole.original_shape (n : ℕ) :
  (OrderedPartitions.row n 2).natDegree = n / 2 ∧
    0 < (OrderedPartitions.row n 2).leadingCoeff ∧ 0 < Polynomial.eval 0 (OrderedPartitions.row n 2)
OrderedPartitions.TwoPole.iterate_dslope_inv_G_at_zero {q : ℝ} (hq : q < 1) (n : ℕ) :
  (fun f => dslope f 0)^[n] (fun z => (OrderedPartitions.TwoPole.G q z)⁻¹) 0 =
    ↑(Polynomial.eval (-q / (1 - q)) (OrderedPartitions.row n 2)) / ((1 - ↑q) * ↑n.factorial)
OrderedPartitions.TwoPole.taylor_residues {q : ℝ} (hq : 0 < q) (h1 : q < 1) (crit : -1 < Real.log q + (1 - 2 * q))
  {z : ℂ} (gz : OrderedPartitions.TwoPole.G q z = 0) (iz : z.im ∈ Set.Ioo 0 (Real.pi / 2)) (n : ℕ) :
  (OrderedPartitions.TwoPole.taylor n fun w => (OrderedPartitions.TwoPole.G q w)⁻¹) =
    OrderedPartitions.TwoPole.contour q n - (deriv (OrderedPartitions.TwoPole.G q) z)⁻¹ / z ^ (n + 1) -
      (deriv (OrderedPartitions.TwoPole.G q) ((starRingEnd ℂ) z))⁻¹ / (starRingEnd ℂ) z ^ (n + 1)
OrderedPartitions.TwoPole.relative_one_of_twenty {q : ℝ} (hq : 1 / 6 < q) (h1 : q < 1) {z : ℂ}
  (gz : OrderedPartitions.TwoPole.G q z = 0) (iz : z.im ∈ Set.Ioo 0 (Real.pi / 2)) {n : ℕ} (hn : 20 ≤ n) :
  ‖deriv (OrderedPartitions.TwoPole.G q) z‖ * ‖z‖ ^ (n + 1) / 2 * ‖OrderedPartitions.TwoPole.contour q n‖ ≤
    Real.sin z.arg / 4
OrderedPartitions.TwoPole.relative_two_of_twentyfive {q : ℝ} (hq : 1 / 6 < q) (h1 : q < 1) {z : ℂ}
  (gz : OrderedPartitions.TwoPole.G q z = 0) (iz : z.im ∈ Set.Ioo 0 (Real.pi / 2)) {n : ℕ} (hn : 25 ≤ n) :
  ‖deriv (OrderedPartitions.TwoPole.G q) z‖ * ‖z‖ ^ (n + 1) / 2 * ‖OrderedPartitions.TwoPole.contour q n‖ ≤
    Real.sin (2 * z.arg) / 8
OrderedPartitions.TwoPole.principal_exists {q : ℝ} (hq : 0 < q) (crit : -1 < Real.log q + (1 - 2 * q)) :
  ∃ z,
    OrderedPartitions.TwoPole.G q z = 0 ∧
      z.im ∈ Set.Ioo 0 (Real.pi / 2) ∧ ∀ (w : ℂ), OrderedPartitions.TwoPole.G q w = 0 → w.im ∈ Set.Ioo 0 Real.pi → w = z
OrderedPartitions.TwoPolePhase.ordered_pair_of_parameter_limits {d : ℕ} {p q : Polynomial ℝ} {c L R : ℝ}
  {ψ shift E F scaleOld scaleNew : ℝ → ℝ} (p_degree : p.natDegree = d) (p_nonzero : p ≠ 0)
  (q_degree : q.natDegree = d ∨ q.natDegree = d + 1) (q_leading : 0 < q.leadingCoeff)
  (q_at_zero : 0 < Polynomial.eval 0 q) (c_nonneg : 0 ≤ c) (c_lt : c < 1) (phase : ContinuousOn ψ (Set.Ioo c 1))
  (far_left : Filter.Tendsto ψ (nhdsWithin 1 (Set.Iio 1)) (nhds L))
  (near_right : Filter.Tendsto ψ (nhdsWithin c (Set.Ioi c)) (nhds R))
  (front : ↑d * Real.pi + (Real.pi - Real.pi / 4) < L) (back : R < Real.pi + Real.pi / 4)
  (old_model :
    ∀ u ∈ Set.Ioo c 1,
      0 < scaleOld u ∧
        |E u| ≤ Real.sin (shift u) / 4 ∧
          scaleOld u * Polynomial.eval (OrderedPartitions.TwoPolePhase.negativeAxis u) p = -Real.cos (ψ u) + E u)
  (new_model :
    ∀ u ∈ Set.Ioo c 1,
      0 < Real.sin (shift u) ∧
        0 < scaleNew u ∧
          |F u| ≤ Real.sin (shift u) / 4 ∧
            scaleNew u * Polynomial.eval (OrderedPartitions.TwoPolePhase.negativeAxis u) q =
              -Real.cos (ψ u + shift u) + F u) :
  OrderedPartitions.RootTracking.OrderedPair d p q
